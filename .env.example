# ==========================================
# BarberAdmin - Variáveis de Ambiente
# ==========================================

# Banco de Dados PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=barberadmin_db
DB_USER=barberadmin
DB_PASSWORD=barberadmin_secret_2026

# Porta externa do PostgreSQL na máquina host
POSTGRES_EXTERNAL_PORT=5432

# Backend Spring Boot 3 (Java 21)
BACKEND_PORT=8080

# Adminer (Interface Web para gerenciamento do banco)
ADMINER_PORT=8088

# Frontend (Vue 3 + Vite)
FRONTEND_PORT=5173

# Integração com BarberNotify
BARBERNOTIFY_API_KEY=barbernotify_secret_token_2026
BARBERNOTIFY_WEBHOOK_SECRET=barbernotify_webhook_secret_2026

# Configurações do Sistema
NODE_ENV=development
APP_NAME="BarberAdmin"
APP_TIMEZONE="America/Sao_Paulo"
