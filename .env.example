# ==========================================
# BarberAdmin - Variáveis de Ambiente
# ==========================================

# Banco de Dados PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=barberadmin_db
DB_USER=barberadmin
DB_PASSWORD=coloque_sua_senha_segura_aqui

# Porta externa do PostgreSQL na máquina host
POSTGRES_EXTERNAL_PORT=5432

# Backend Spring Boot 3 (Java 21)
BACKEND_PORT=8080

# Frontend (Vue 3 + Vite)
FRONTEND_PORT=5173

# Integração com BarberNotify
BARBERNOTIFY_API_KEY=coloque_sua_chave_api_aqui
BARBERNOTIFY_WEBHOOK_SECRET=coloque_seu_webhook_secret_aqui

# Configurações do Sistema
NODE_ENV=development
APP_NAME="BarberAdmin"
APP_TIMEZONE="America/Sao_Paulo"
